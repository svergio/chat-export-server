{
  "name": "chat-export-server",
  "version": "0.1.0",
  "description": "Local MCP server that drives the Chat Export browser extension (ChatGPT, Grok, X Grok, Copilot).",
  "private": true,
  "type": "module",
  "bin": {
    "chat-export-server": "./dist/cli/index.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/cli/index.js start",
    "dev": "tsx watch src/cli/index.ts start",
    "mcp": "node dist/cli/index.js start --stdio",
    "key": "node dist/cli/index.js key",
    "status": "node dist/cli/index.js status",
    "schema": "npm run schema -w @chat-export/protocol"
  },
  "dependencies": {
    "@chat-export/protocol": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svergio/chat-export-server.git"
  },
  "license": "ISC"
}

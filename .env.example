# Copy to .env and adjust. Loaded from server cwd unless CHAT_EXPORT_ENV_FILE is set.

CHAT_EXPORT_HOME=
CHAT_EXPORT_HOST=127.0.0.1
CHAT_EXPORT_PORT=8765
CHAT_EXPORT_ALLOWED_HOSTS=

CHAT_EXPORT_DASHBOARD_ENABLED=true
CHAT_EXPORT_ADMIN_USER=admin
CHAT_EXPORT_ADMIN_PASS=

CHAT_EXPORT_MCP_TOKEN=
CHAT_EXPORT_BROWSER_TOKENS=
# Example: b-abc12345:ceb_...hex:Chrome Work,b-def67890:ceb_...hex:Chrome

CHAT_EXPORT_ALLOW_DESTRUCTIVE=false

CHAT_EXPORT_DB_DRIVER=sqlite
CHAT_EXPORT_DB_URL=

CHAT_EXPORT_SKIP_MCP_CONFIG=

        "qwen",
        "deepseek",
        "perplexity"
      ]
    },
    "Op": {
      "type": "string",
      "enum": [
        "chats.list",
        "chats.get",
        "chats.export",
        "chats.create",
        "chats.delete",
        "chats.send",
        "platform.capabilities",
        "platform.host_state",
        "containers.list",
        "containers.chats",
        "containers.create",
        "containers.delete",
        "containers.move_chat"

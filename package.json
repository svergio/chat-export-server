{
  "name": "chat-export-server",
  "version": "0.1.0",
  "description": "Local MCP server that drives the Chat Export browser extension (ChatGPT, Grok, X Grok, Copilot).",
  "private": true,
  "type": "module",
  "bin": {
    "chat-export-server": "./src/cli/index.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/cli/index.js start",
    "mcp": "node src/cli/index.js start --stdio",
    "key": "node src/cli/index.js key",
    "status": "node src/cli/index.js status",
    "schema": "npm run schema -w @chat-export/protocol"
  },
  "dependencies": {
    "@chat-export/protocol": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.18.3",
    "zod": "^3.25.76"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svergio/chat-export-server.git"
  },
  "license": "ISC"
}

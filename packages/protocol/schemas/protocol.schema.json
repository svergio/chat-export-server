  "title": "chat-export protocol v1",
  "x-protocol-version": 1,
  "x-ops": {
    "chats.list": {
      "args": "ChatsListArgs",
      "result": "ChatsListResult"
    },
    "chats.get": {
      "args": "ChatsGetArgs",
      "result": "ChatsGetResult"
    },
    "chats.export": {
      "args": "ChatsExportArgs",
      "result": "ChatsExportResult"
    },
    "chats.create": {
      "args": "ChatsCreateArgs",
      "result": "ChatsCreateResult"
    },
    "chats.delete": {
      "args": "ChatsDeleteArgs",
      "result": "ChatsDeleteResult"
    },
    "chats.send": {
      "args": "ChatsSendArgs",
      "result": "ChatsSendResult"
    },
    "platform.capabilities": {
      "args": "PlatformCapabilitiesArgs",
      "result": "Capabilities"
    },
    "platform.host_state": {
      "args": "PlatformHostStateArgs",
      "result": "PlatformHostStateResult"
    },
    "containers.list": {
      "args": "ContainersListArgs",
      "result": "ContainersListResult"
    },
    "containers.chats": {
      "args": "ContainersChatsArgs",
      "result": "ChatsListResult"
    },
    "containers.create": {
      "args": "ContainersCreateArgs",
      "result": "ContainersCreateResult"
    },
    "containers.delete": {
      "args": "ContainersDeleteArgs",
      "result": "ContainersDeleteResult"
    },
    "containers.move_chat": {
      "args": "ContainersMoveChatArgs",
      "result": "ContainersMoveChatResult"
    }

{
  "name": "chat-export-server",
  "version": "1.0.4",
  "description": "Local MCP server that drives the Chat Export Chrome extension across ChatGPT, Grok, X Grok, Claude, Copilot, Qwen, DeepSeek and Perplexity on 127.0.0.1.",
  "mcpName": "io.github.svergio/chat-export-server",
  "type": "module",
  "bin": {
    "chat-export-server": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "packages/protocol/src",
    "packages/protocol/schemas",
    "packages/protocol/package.json",
    "README.md",
    "LICENSE",
    "server.json",
    "glama.json"
  ],
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/cli/index.js start",
    "dev": "tsx watch src/cli/index.ts start",
    "mcp": "node dist/cli/index.js start --stdio",
    "key": "node dist/cli/index.js key",
    "status": "node dist/cli/index.js status",
    "schema": "npm run schema -w @chat-export/protocol",
    "test:unit": "npm run build && node --test --test-reporter spec test/unit/*.test.js",
    "test:contract": "npm run build && node --test --test-reporter spec test/contract/*.test.js",
    "test:protocol": "node --test --test-reporter spec packages/protocol/test/*.test.js",
    "test": "npm run test:unit && npm run test:protocol",
    "test:all": "npm run test:unit && npm run test:contract && npm run test:protocol",
    "test:ci": "npm run test:all"
  },
  "dependencies": {
    "@chat-export/protocol": "*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ws": "^8.18.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/svergio/chat-export-server.git"
  },
  "license": "MIT"
}
